# Copy this file to .env (same folder) and fill in real values. .env is already in
# .gitignore — never remove it from there, and never paste a real private key into chat.

# Arc Testnet RPC. Docs-confirmed primary endpoint as of writing — if this ever stops
# working, check https://docs.arc.io/arc/references/connect-to-arc for current ones,
# there are also Blockdaemon/dRPC/QuickNode alternatives listed there.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# The private key of the wallet that will deploy the contract and become its initial
# owner. STRONGLY recommended: generate a brand new wallet for this specifically —
# never use a wallet that holds real funds or that you use anywhere else. This key
# controls setRouter/setDefaultFees/pause/etc. on the deployed contract until you
# transfer ownership to a multisig.
#
# To generate a fresh one: in Node, run `node -e "console.log(require('ethers').Wallet.createRandom())"`
# — copy the privateKey field (starts with 0x) below, and separately save the address
# somewhere, since that's what you'll fund from the faucet.
DEPLOYER_PRIVATE_KEY=

# Where creation fees and trading fees get sent. Can be the same address as the
# deployer for now on testnet — should be a multisig before mainnet, per everything
# discussed about the pause/admin functions.
TREASURY_ADDRESS=

# Ethereum-mainnet archive RPC, for the FORK=1 suite (test/Fork.v2.test.js, real
# Uniswap V2 at the pinned block). Only needed to run that suite; ordinary test runs
# are local and unforked.
MAINNET_RPC_URL=

# Base archive RPC, for the FORK_BASE=1 suite (test/Fork.v4.test.js, real Uniswap V4).
# Optional: defaults to https://mainnet.base.org, which does serve archive state at the
# pinned block but rate-limits, so the first run is slow while Hardhat fills its cache.
# NOTE an Alchemy key for eth-mainnet does NOT cover Base automatically -- the network
# has to be enabled on the app, and is not by default.
BASE_RPC_URL=
