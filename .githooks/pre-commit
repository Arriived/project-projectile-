#!/bin/sh
# Refuse to commit a mutated contract.
#
# A red-proof mutates contracts/ on disk. If the run is killed before its restore, the
# mutation stays in the working tree -- this has happened. The bad outcome is not a lost
# hour, it is a mutation surviving into a commit unnoticed.
#
# Markers below are exactly what the harness and ad-hoc proofs write.
if git diff --cached --name-only | grep -q '^contracts/'; then
  HITS=$(git diff --cached -U0 -- contracts/ \
    | grep '^+' | grep -vE '^\+\+\+' \
    | grep -nE '// *MUTATED|if \(false\) revert|PLACEHOLDER_NOMATCH')
  if [ -n "$HITS" ]; then
    echo "COMMIT REFUSED: mutation marker found in staged contracts/ changes:"
    echo "$HITS"
    echo
    echo "This is a red-proof mutation, not real work. Restore with:"
    echo "    git checkout -- contracts/"
    echo "Override only if you are certain:  git commit --no-verify"
    exit 1
  fi
fi
exit 0
