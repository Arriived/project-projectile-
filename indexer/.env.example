# Copy this file to .env and fill in real values. Never commit .env itself.

# From Supabase: Project Settings -> Data API (the URL), Settings -> API Keys (service_role)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Arc testnet RPC endpoint. A plain https:// RPC works for catching up on historical
# events; if you have a wss:// (websocket) endpoint, use that instead for FACTORY_RPC_URL
# so new events arrive in real time rather than only being picked up on a polling interval.
FACTORY_RPC_URL=https://5042002.rpc.thirdweb.com

# Filled in once ArcLaunchFactory is actually deployed to Arc testnet — the indexer has
# nothing to watch without this. See the deployment script (next step) for getting this.
FACTORY_ADDRESS=

# The block ArcLaunchFactory was deployed at. Lets the indexer start catching up from
# here instead of scanning from block 0, which would be needlessly slow.
FACTORY_DEPLOY_BLOCK=0
