node_modules/
artifacts-manual/
artifacts/
cache/
*.log
.DS_Store
Thumbs.db
out/

# Static-analysis output (regenerate with scripts, do not commit)
slither.json
slither.err

__pycache__/


# The mutation lease. Never commit it -- its presence is what blocks a commit.
.mutation-lease

# Vite build output for the React app (app/). node_modules and .env.local are
# already covered by the patterns above, which match at any depth.
app/dist/
app/tsconfig.tsbuildinfo

.vercel

# ⚠ ONE PATTERN, NOT A LIST OF THE VARIANTS WE HAPPEN TO HAVE CREATED.
#
# This replaced `.env`, `.env.local`, `.env.*.local`, `.env*.tmp` and `.env*.tmp.txt`.
# That list was assembled one incident at a time and still missed everything it had not
# yet been bitten by: `.env.production.tmp.bak`, `.env.prod.backup`, `.env.production.txt`
# and `.env.local.tmp.json` were all verified UNIGNORED with `git check-ignore` while the
# list looked comprehensive.
#
# The list also produced a documentation failure worth remembering: `.env*.tmp.txt` was
# added in commit dc7e083, in the SAME commit whose prose stated the gap was "real and
# unfixed" -- written from an earlier measurement and never re-measured.
#
# `.env*` matches the whole class, including variants nobody has invented yet. The
# negation keeps the one file that must stay tracked.
.env*
!.env.example
