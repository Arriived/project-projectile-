# Secrets and machine-local state are excluded at every depth.
.env
.env.*
.claude
.claude/**
.vercel
.vercel/**
node_modules
node_modules/**

# Generated outputs are rebuilt by Vercel.
artifacts
artifacts/**
cache
cache/**
out
out/**
dist
dist/**
*.tsbuildinfo
