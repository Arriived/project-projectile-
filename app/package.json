{
  "name": "ballista-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify:chain": "node --experimental-strip-types scripts/verify-chain.mts",
    "verify:guard": "node --experimental-strip-types scripts/verify-guard.mts",
    "verify": "node --experimental-strip-types scripts/verify-all.mts",
    "verify:wallets": "node --experimental-strip-types scripts/verify-wallets.mts",
    "measure:gas": "node --experimental-strip-types scripts/measure-gas.mts",
    "verify:trade": "node --experimental-strip-types scripts/verify-trade.mts",
    "verify:i18n": "node --experimental-strip-types scripts/verify-i18n.mts",
    "verify:claims": "node --experimental-strip-types scripts/verify-claims.mts",
    "verify:list": "node --experimental-strip-types scripts/verify-list.mts",
    "verify:create": "node --experimental-strip-types scripts/verify-create.mts",
    "verify:upload": "node --experimental-strip-types scripts/verify-upload.mts",
    "verify:address": "node --experimental-strip-types scripts/verify-address.mts",
    "verify:slippage": "node --experimental-strip-types scripts/verify-slippage.mts",
    "verify:metadata": "node --experimental-strip-types scripts/verify-metadata.mts",
    "verify:launchbuy": "node --experimental-strip-types scripts/verify-launchbuy.mts",
    "verify:quotefresh": "node --experimental-strip-types scripts/verify-quote-freshness.mts",
    "verify:strip": "node --experimental-strip-types scripts/verify-strip-comments.mts",
    "verify:theme": "node --experimental-strip-types scripts/verify-theme.mts",
    "verify:switch": "node --experimental-strip-types scripts/verify-switch-failure.mts"
