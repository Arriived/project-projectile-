  "dependencies": {
    "@circle-fin/adapter-solana": "^1.7.2",
    "@circle-fin/adapter-viem-v2": "^1.17.1",
    "@circle-fin/bridge-kit": "^1.14.1",
    "@metamask/connect-evm": "^2.1.1",
    "@tanstack/react-query": "^5.62.0",
    "@walletconnect/ethereum-provider": "^2.24.0",
    "lightweight-charts": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3",
    "viem": "^2.56.0",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
