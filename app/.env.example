# Vite inlines every VITE_-prefixed variable into the CLIENT BUNDLE.
# The anon key is public by design -- it is what the browser ships, and RLS is what
# protects the data. Verified 11/11 against the live project with this key.
#
# NEVER add SUPABASE_SERVICE_ROLE_KEY here, or any variable holding it. It bypasses RLS
# entirely. It belongs to the indexer process, in indexer/.env, outside this app root.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# WalletConnect. PUBLIC BY DESIGN -- it ships in the client bundle because the relay needs
# it from the browser. It is an origin-scoped rate-limit and analytics handle, not a
# credential: it grants no access to funds and signs nothing. Kept out of the repo anyway
# so a fork does not spend this project's quota.
#
# Optional. Leave it unset and the WalletConnect connector is simply not built -- a button
# that cannot connect is worse than no button. Get one at https://dashboard.reown.com
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
